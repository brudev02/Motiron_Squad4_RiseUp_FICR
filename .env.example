# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" não é versionado.

# Banco SQLite local (criado por "npm run db:push").
DATABASE_URL="file:./dev.db"

# Chave usada para assinar a sessão (JWT). Obrigatória.
# Use uma string longa e aleatória (mínimo de 32 caracteres), por exemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
